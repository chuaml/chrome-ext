{
    "name": "custom ext",
    "version": "1.0",
    "manifest_version": 3,
    "background": {
        "service_worker": "sw.js"
    },
    "action": {
        "default_popup": "popup.menu.html"
    },
    "permissions": [
        "storage",
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "web_accessible_resources": [
        {
            "matches": [
                "https://*/*",
                "http://*/*"
            ],
            "resources": [
                "/public/*",
                "/public/*.mjs",
                "/public/*.js",
                "/public/*.css",
                "/public/*.html"
            ]
        }
    ],
    "content_scripts": [
        {
            "matches": [
                "https://*/*",
                "http://*/*"
            ],
            "run_at": "document_start",
            "js": [
                "main.js"
            ]
        },
        {
            "matches": [
                "https://idx.dev/*"
            ],
            "exclude_matches": [
                "https://*.google.com/*",
                "https://vscode.dev/*",
                "https://idx.dev/*",
                "https://idx.google.com/*",
                "https://github.dev/*",
                "https://github.com/*",
                "https://www.youtube.com/*"
            ],
            "run_at": "document_start",
            "css": [
                "darkmode/darkmode.css"
            ]
        },
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "exclude_matches": [
                "https://mail.google.com/*",
                "https://accounts.google.com/*",
                "https://myaccount.google.com/*",
                "https://drive.google.com/*",
                "https://docs.google.com/*",
                "https://vscode.dev/*",
                "https://idx.dev/*",
                "https://idx.google.com/*",
                "https://github.dev/*",
                "https://github.com/*",
                "https://chat.deepseek.com/*"
            ],
            "run_at": "document_start",
            "js": [
                "anti-tracker/gtag-denied.js",
                "anti-tracker/referrer-policy.js"
            ],
            "world": "MAIN"
        }
    ]
}