{
    "version": "0.2.0",
    "configurations": [
        {    // is to launch a new chrome instance with a separated user profile, load current src as extension, then debug it
            "name": "debug chrome extension",
            "type": "chrome",
            "request": "launch",
            "url": "chrome://extensions/",
            "runtimeArgs": [
                "--disable-features=DisableLoadExtensionCommandLineSwitch",    // turn off security feature for v137^
                "--load-extension=${workspaceFolder}",    // current project dir; do not quote "" the path
                "--user-data-dir=${workspaceFolder}/.temp",    // recommend, to clean up this profile data later
                "--profile-directory=kltag",    // optional profile name
                "--no-first-run"    // skip welcome page
            ],
        },
    ]
}